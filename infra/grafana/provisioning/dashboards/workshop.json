{
  "uid": "workshop",
  "title": "API Scaling Workshop",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(workshop_http_requests_total{route!~\"/metrics|/health|/ready\"}[1m]))",
          "legendFormat": "{{status}}{{route}}{{instance}}{{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "p99 by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(workshop_http_request_duration_seconds_bucket{route!~\"/metrics|/health|/ready\"}[1m])))",
          "legendFormat": "{{status}}{{route}}{{instance}}{{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Cache hits and misses",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (__name__) (rate({__name__=~\"workshop_redis_cache_(hits|misses)_total\"}[1m]))",
          "legendFormat": "{{status}}{{route}}{{instance}}{{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Pool waiters by replica",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "workshop_db_pool_waiting",
          "legendFormat": "{{status}}{{route}}{{instance}}{{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Jobs accepted per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(workshop_jobs_enqueued_total[1m]))",
          "legendFormat": "{{status}}{{route}}{{instance}}{{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "API CPU cores used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "workshop-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_user_seconds_total{job=\"workshop-api\"}[1m]) + rate(process_cpu_system_seconds_total{job=\"workshop-api\"}[1m])",
          "legendFormat": "{{status}}{{route}}{{instance}}{{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
